{
  "expo": {
    "name": "RAWLZ",
    "slug": "rawlz",
    "scheme": "rawlz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "bundleIdentifier": "app.rawlz.mobile",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "RAWLZ ben\u00f6tigt Kamera-Zugriff f\u00fcr QR-Code-Scanning.",
        "NSPhotoLibraryUsageDescription": "RAWLZ ben\u00f6tigt Foto-Zugriff zum Speichern von Share-Cards."
      }
    },
    "android": {
      "package": "app.rawlz.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "rawlz"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1A1A2E"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "81a12998-c32a-4636-83e3-2cc28e1145fe"
      }
    },
    "owner": "pakuccino",
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#111827",
      "androidMode": "default",
      "androidCollapsedTitle": "#{unread_notifications} neue Benachrichtigungen"
    }
  }
}